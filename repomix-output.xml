                value={coreDescription}
                onChange={(e) => setCoreDescription(e.target.value)}
                className="w-full mt-1 bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-sm text-white focus:border-amber-500 outline-none"
              />
            </div>

            <div>
              <label className="text-xs text-zinc-400 uppercase font-medium">World Setting & Environment Lore</label>
              <textarea
                required
                rows={3}
                placeholder="Geographic layout, political tensions, environmental tone..."
                value={worldSetting}
                onChange={(e) => setWorldSetting(e.target.value)}
                className="w-full mt-1 bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-sm text-white focus:border-amber-500 outline-none"
              />
            </div>

            <div>
              <label className="text-xs text-zinc-400 uppercase font-medium">Rule Mechanics & Custom Systems</label>
              <textarea
                rows={2}
                placeholder="e.g. Sanity meters, scarcity-based inventory, non-standard magic rules..."
                value={ruleMechanics}
                onChange={(e) => setRuleMechanics(e.target.value)}
                className="w-full mt-1 bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-sm text-white focus:border-amber-500 outline-none"
              />
            </div>
          </div>

          {/* Section 2: Lorebook Registry */}
          <div className="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 space-y-6">
            <div className="flex items-center gap-2">
              <BookOpen className="w-5 h-5 text-amber-500" />
              <h2 className="text-lg font-semibold text-white">Dynamic Lorebook Registry</h2>
            </div>
            <p className="text-xs text-zinc-400">
              Entries are dynamically injected into the AI context window when keyword triggers match player input actions or recent turns.
            </p>

            {/* List Existing Entries */}
            {loreEntries.length > 0 && (
              <div className="space-y-3">
                {loreEntries.map((entry, idx) => (
                  <div key={idx} className="p-3 bg-zinc-950 border border-zinc-800 rounded-lg flex justify-between items-start">
                    <div>
                      <div className="flex items-center gap-2">
                        <span className="font-semibold text-sm text-white">{entry.title}</span>
                        <span className="text-[10px] bg-zinc-800 text-zinc-300 px-2 py-0.5 rounded">{entry.category}</span>
                        <span className="text-[10px] bg-amber-950 text-amber-400 px-2 py-0.5 rounded border border-amber-800">
                          {entry.activation_mode}
                        </span>
                      </div>
                      <p className="text-xs text-zinc-400 mt-1">{entry.content}</p>
                      <div className="flex flex-wrap gap-1 mt-2">
                        {entry.trigger_keys.map((k) => (
                          <span key={k} className="text-[10px] bg-zinc-900 text-zinc-400 border border-zinc-800 px-1.5 py-0.5 rounded">
                            #{k}
                          </span>
                        ))}
                      </div>
                    </div>
                    <button
                      type="button"
                      onClick={() => handleRemoveLoreEntry(idx)}
                      className="text-zinc-500 hover:text-red-400 p-1"
                    >
                      <Trash2 className="w-4 h-4" />
                    </button>
                  </div>
                ))}
              </div>
            )}

            {/* Add New Lore Entry Draft */}
            <div className="border border-dashed border-zinc-800 rounded-lg p-4 space-y-4 bg-zinc-950/40">
              <span className="text-xs font-semibold uppercase text-zinc-400">Add Lore Entry</span>
              
              <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
                <div>
                  <input
                    type="text"
                    placeholder="Entry Title (e.g. Order of the Sun)"
                    value={newEntry.title}
                    onChange={(e) => setNewEntry({ ...newEntry, title: e.target.value })}
                    className="w-full bg-zinc-950 border border-zinc-800 rounded p-2 text-xs text-white"
                  />
                </div>
                <div>
                  <select
                    value={newEntry.category}
                    onChange={(e) => setNewEntry({ ...newEntry, category: e.target.value as LoreCategory })}
                    className="w-full bg-zinc-950 border border-zinc-800 rounded p-2 text-xs text-white"
                  >
                    {LORE_CATEGORIES.map((c) => <option key={c} value={c}>{c}</option>)}
                  </select>
                </div>
                <div>
                  <select
                    value={newEntry.activation_mode}
                    onChange={(e) => setNewEntry({ ...newEntry, activation_mode: e.target.value as ActivationMode })}
                    className="w-full bg-zinc-950 border border-zinc-800 rounded p-2 text-xs text-white"
                  >
                    {ACTIVATION_MODES.map((m) => <option key={m} value={m}>{m}</option>)}
                  </select>
                </div>
              </div>

              <div>
                <textarea
                  rows={2}
                  placeholder="Lore details, behavioral traits, or hidden secrets..."
                  value={newEntry.content}
                  onChange={(e) => setNewEntry({ ...newEntry, content: e.target.value })}
                  className="w-full bg-zinc-950 border border-zinc-800 rounded p-2 text-xs text-white"
                />
              </div>

              {/* Keyword Trigger Chips */}
              {newEntry.activation_mode === 'Keyword Triggered' && (
                <div className="space-y-2">
                  <div className="flex gap-2">
                    <input
                      type="text"
                      placeholder="Add comma-separated keywords (e.g. paladin, dawn, solar)"
                      value={triggerInput}
                      onChange={(e) => setTriggerInput(e.target.value)}
                      onKeyDown={(e) => { if (e.key === 'Enter') { e.preventDefault(); addTriggerKey(); } }}
                      className="flex-1 bg-zinc-950 border border-zinc-800 rounded p-1.5 text-xs text-white"
                    />
                    <button
                      type="button"
                      onClick={addTriggerKey}
                      className="bg-zinc-800 hover:bg-zinc-700 px-3 py-1 text-xs rounded text-zinc-200"
                    >
                      Add Keys
                    </button>
                  </div>

                  <div className="flex flex-wrap gap-1.5">
                    {newEntry.trigger_keys.map((k) => (
                      <span
                        key={k}
                        onClick={() => removeTriggerKey(k)}
                        className="inline-flex items-center gap-1 text-[11px] bg-zinc-800 hover:bg-red-950 hover:text-red-300 text-zinc-300 px-2 py-0.5 rounded cursor-pointer"
                      >
                        {k} &times;
                      </span>
                    ))}
                  </div>
                </div>
              )}

              <button
                type="button"
                onClick={handleAddLoreEntry}
                className="w-full py-2 bg-zinc-800 hover:bg-zinc-700 text-xs text-zinc-200 font-medium rounded flex items-center justify-center gap-1.5 transition"
              >
                <Plus className="w-3.5 h-3.5" /> Attach Entry to Lorebook
              </button>
            </div>
          </div>

          <button
            type="submit"
            disabled={loading}
            className="w-full py-3 bg-amber-600 hover:bg-amber-500 text-white font-semibold rounded-lg text-sm transition disabled:opacity-50"
          >
            {loading ? 'Creating Campaign...' : 'Publish Campaign'}
          </button>
        </form>
      </div>
    </div>
  )
}
</file>

<file path="src/app/characters/CharacterEditor.tsx">
'use client'

import { useState } from 'react'
import { saveCharacter, CharacterFormData } from './actions'

const defaultStats = { STR: 10, DEX: 10, CON: 10, INT: 10, WIS: 10, CHA: 10 }

type CharacterRecord = CharacterFormData & { id?: number }

export default function CharacterEditor({ characters }: { characters: CharacterRecord[] }) {
  const [selectedChar, setSelectedChar] = useState<CharacterFormData | null>(null)
  const [isSaving, setIsSaving] = useState(false)

  const handleNew = () => {
    setSelectedChar({
      name: '',
      class_archetype: '',
      current_hp: 10,
      max_hp: 10,
      armor_class: 10,
      stats: { ...defaultStats },
      appearance: '',
      backstory: '',
      strengths: '',
      weaknesses: '',
      inventory: '',
      status_condition: 'Normal',
    })
  }

  const handleStatChange = (stat: keyof typeof defaultStats, value: number) => {
    if (!selectedChar) return
    setSelectedChar({
      ...selectedChar,
      stats: { ...selectedChar.stats, [stat]: value },
    })
  }

  const onSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!selectedChar) return
    setIsSaving(true)
    try {
      await saveCharacter(selectedChar)
      setSelectedChar(null)
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : 'Failed to save character.'
      alert(message)
    } finally {
      setIsSaving(false)
    }
  }

  return (
    <div className="grid grid-cols-1 md:grid-cols-3 gap-8">
      {/* Character Cards Roster */}
      <div className="md:col-span-1 space-y-4">
        <button
          onClick={handleNew}
          className="w-full py-2.5 px-4 bg-amber-600 hover:bg-amber-500 text-white font-medium rounded-lg text-sm transition"
        >
          + Create New Character
        </button>

        <div className="space-y-3">
          {characters.map((char) => (
            <div
              key={char.id}
              onClick={() => setSelectedChar(char)}
              className={`p-4 rounded-lg border cursor-pointer transition ${
                selectedChar?.id === char.id
                  ? 'border-amber-500 bg-zinc-900'
                  : 'border-zinc-800 bg-zinc-900/40 hover:border-zinc-700'
              }`}
            >
              <div className="flex justify-between items-start">
                <h3 className="font-semibold text-white">{char.name}</h3>
                <span className="text-xs px-2 py-0.5 rounded bg-zinc-800 text-zinc-300">
                  {char.class_archetype}
                </span>
              </div>
              <p className="text-xs text-zinc-400 mt-2">
                HP: {char.current_hp}/{char.max_hp} | AC: {char.armor_class} | Status: {char.status_condition}
              </p>
            </div>
          ))}
          {characters.length === 0 && (
            <p className="text-zinc-500 text-xs italic">No characters saved yet.</p>
          )}
        </div>
      </div>

      {/* Editor Form */}
      <div className="md:col-span-2">
        {selectedChar ? (
          <form onSubmit={onSubmit} className="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 space-y-6">
            <div className="grid grid-cols-2 gap-4">
              <div>
                <label className="text-xs text-zinc-400 uppercase">Character Name</label>
                <input
                  type="text"
                  required
                  value={selectedChar.name}
                  onChange={(e) => setSelectedChar({ ...selectedChar, name: e.target.value })}
                  className="w-full mt-1 bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-sm text-white"
                />
              </div>
              <div>
                <label className="text-xs text-zinc-400 uppercase">Class / Archetype</label>
                <input
                  type="text"
                  required
                  value={selectedChar.class_archetype}
                  onChange={(e) => setSelectedChar({ ...selectedChar, class_archetype: e.target.value })}
                  className="w-full mt-1 bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-sm text-white"
                />
              </div>
            </div>

            {/* Combat Vitals */}
            <div className="grid grid-cols-3 gap-4">
              <div>
                <label className="text-xs text-zinc-400 uppercase">Current HP</label>
                <input
                  type="number"
                  value={selectedChar.current_hp}
                  onChange={(e) => setSelectedChar({ ...selectedChar, current_hp: Number(e.target.value) })}
                  className="w-full mt-1 bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-sm text-white"
                />
              </div>
              <div>
                <label className="text-xs text-zinc-400 uppercase">Max HP</label>
                <input
                  type="number"
                  value={selectedChar.max_hp}
                  onChange={(e) => setSelectedChar({ ...selectedChar, max_hp: Number(e.target.value) })}
                  className="w-full mt-1 bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-sm text-white"
                />
              </div>
              <div>
                <label className="text-xs text-zinc-400 uppercase">Armor Class (AC)</label>
                <input
                  type="number"
                  value={selectedChar.armor_class}
                  onChange={(e) => setSelectedChar({ ...selectedChar, armor_class: Number(e.target.value) })}
                  className="w-full mt-1 bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-sm text-white"
                />
              </div>
            </div>

            {/* Attributes */}
            <div>
              <label className="text-xs text-zinc-400 uppercase block mb-2">Attributes (Stats)</label>
              <div className="grid grid-cols-6 gap-2">
                {(['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA'] as const).map((stat) => (
                  <div key={stat} className="bg-zinc-950 border border-zinc-800 rounded p-2 text-center">
                    <span className="text-[10px] text-zinc-500 font-bold block">{stat}</span>
                    <input
                      type="number"
                      value={selectedChar.stats[stat]}
                      onChange={(e) => handleStatChange(stat, Number(e.target.value))}
                      className="w-full text-center bg-transparent text-sm font-semibold text-amber-400 outline-none"
                    />
                  </div>
                ))}
              </div>
            </div>

            {/* Descriptive Profile */}
            <div className="grid grid-cols-2 gap-4">
              <div>
                <label className="text-xs text-zinc-400 uppercase">Strengths & Proficiencies</label>
                <textarea
                  rows={2}
                  value={selectedChar.strengths || ''}
                  onChange={(e) => setSelectedChar({ ...selectedChar, strengths: e.target.value })}
                  className="w-full mt-1 bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-xs text-white"
                />
              </div>
              <div>
                <label className="text-xs text-zinc-400 uppercase">Weaknesses & Flaws</label>
                <textarea
                  rows={2}
                  value={selectedChar.weaknesses || ''}
                  onChange={(e) => setSelectedChar({ ...selectedChar, weaknesses: e.target.value })}
                  className="w-full mt-1 bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-xs text-white"
                />
              </div>
            </div>

            <div className="grid grid-cols-2 gap-4">
              <div>
                <label className="text-xs text-zinc-400 uppercase">Inventory (Item Log)</label>
                <textarea
                  rows={3}
                  value={selectedChar.inventory || ''}
                  onChange={(e) => setSelectedChar({ ...selectedChar, inventory: e.target.value })}
                  className="w-full mt-1 bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-xs text-white"
                />
              </div>
              <div>
                <label className="text-xs text-zinc-400 uppercase">Backstory & Bio</label>
                <textarea
                  rows={3}
                  value={selectedChar.backstory || ''}
                  onChange={(e) => setSelectedChar({ ...selectedChar, backstory: e.target.value })}
                  className="w-full mt-1 bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-xs text-white"
                />
              </div>
            </div>

            <div className="flex justify-end gap-3 pt-4 border-t border-zinc-800">
              <button
                type="button"
                onClick={() => setSelectedChar(null)}
                className="px-4 py-2 text-xs text-zinc-400 hover:text-white"
              >
                Cancel
              </button>
              <button
                type="submit"
                disabled={isSaving}
                className="px-5 py-2 text-xs bg-amber-600 hover:bg-amber-500 text-white rounded-lg font-medium"
              >
                {isSaving ? 'Saving...' : 'Save Character Sheet'}
              </button>
            </div>
          </form>
        ) : (
          <div className="h-full border border-dashed border-zinc-800 rounded-xl flex items-center justify-center p-12 text-zinc-500 text-sm">
            Select a character to view or edit, or create a new one.
          </div>
        )}
      </div>
    </div>
  )
}
</file>

<file path="src/app/hub/HubClient.tsx">
'use client'

import { useState, type FormEvent } from 'react'
import { launchTable, joinTableByCode } from './actions'
import { Play, LogIn, Compass } from 'lucide-react'
import Link from 'next/link'

type PublicCampaign = {
  id: string | number
  category: string
  title: string
  core_description: string
}

type ActiveTable = {
  id: string | number
  table_code: string
  current_turn: number | string
  turn_phase: string
  campaigns?: { title?: string } | null
}

export default function HubClient({ publicCampaigns, activeTables }: { publicCampaigns: PublicCampaign[]; activeTables: ActiveTable[] }) {
  const [tableCode, setTableCode] = useState('')
  const [joining, setJoining] = useState(false)

  const handleJoin = async (e: FormEvent<HTMLFormElement>) => {
    e.preventDefault()
    if (!tableCode.trim()) return
    setJoining(true)
    try {
      await joinTableByCode(tableCode)
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : 'Failed to join table.'
      alert(message)
    } finally {
      setJoining(false)
    }
  }

  return (
    <div className="space-y-10">
      {/* Quick Join Bar */}
      <div className="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h2 className="text-base font-semibold text-white">Have a Table Code?</h2>
          <p className="text-xs text-zinc-400">Enter the 6-character code provided by your Head Table.</p>
        </div>
        <form onSubmit={handleJoin} className="flex gap-2 w-full sm:w-auto">
          <input
            type="text"
            maxLength={8}
            placeholder="e.g. 7K4X9B"
            value={tableCode}
            onChange={(e) => setTableCode(e.target.value.toUpperCase())}
            className="bg-zinc-950 border border-zinc-700 px-3 py-2 rounded-lg text-sm tracking-wider uppercase font-mono text-white focus:border-amber-500 outline-none"
          />
          <button
            type="submit"
            disabled={joining}
            className="bg-amber-600 hover:bg-amber-500 px-4 py-2 rounded-lg text-sm font-medium text-white flex items-center gap-1.5"
          >
            <LogIn className="w-4 h-4" /> Join
          </button>
        </form>
      </div>

      {/* Active Tables */}
      {activeTables.length > 0 && (
        <div className="space-y-4">
          <h2 className="text-lg font-semibold text-white">Your Active Tables</h2>
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            {activeTables.map((tbl) => (
              <div key={tbl.id} className="bg-zinc-900/40 border border-zinc-800 rounded-xl p-5 flex flex-col justify-between">
                <div>
                  <span className="text-[10px] uppercase font-mono tracking-widest text-amber-500">CODE: {tbl.table_code}</span>
                  <h3 className="text-base font-semibold text-white mt-1">{tbl.campaigns?.title}</h3>
                  <p className="text-xs text-zinc-400 mt-1">Turn: {tbl.current_turn} | Phase: {tbl.turn_phase}</p>
                </div>
                <Link
                  href={`/table/${tbl.id}`}
                  className="mt-4 inline-flex items-center justify-center gap-2 w-full py-2 bg-zinc-800 hover:bg-zinc-700 rounded-lg text-xs font-medium text-white transition"
                >
                  <Play className="w-3.5 h-3.5" /> Re-enter Table
                </Link>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Public Campaigns */}
      <div className="space-y-4">
        <h2 className="text-lg font-semibold text-white flex items-center gap-2">
          <Compass className="w-5 h-5 text-amber-500" /> Explore Campaigns
        </h2>
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {publicCampaigns.map((camp) => (
            <div key={camp.id} className="bg-zinc-900/40 border border-zinc-800 rounded-xl p-5 flex flex-col justify-between">
              <div>
                <span className="text-xs px-2 py-0.5 rounded bg-zinc-800 text-zinc-300">{camp.category}</span>
                <h3 className="text-lg font-bold text-white mt-2">{camp.title}</h3>
                <p className="text-xs text-zinc-400 mt-2 line-clamp-3">{camp.core_description}</p>
              </div>
              <form action={launchTable.bind(null, String(camp.id))} className="mt-5">
                <button
                  type="submit"
                  className="w-full py-2 bg-amber-600/90 hover:bg-amber-600 rounded-lg text-xs font-semibold text-white transition flex items-center justify-center gap-1.5"
                >
                  <Play className="w-3.5 h-3.5" /> Launch as Head Table
                </button>
              </form>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}
</file>

<file path="src/app/hub/page.tsx">
import { createClient } from '@/lib/supabase/server'
import Link from 'next/link'
import HubClient from './HubClient'

export default async function CampaignHubPage() {
  const supabase = await createClient()
  const { data: { user } } = await supabase.auth.getUser()

  // 1. Public campaigns
  const { data: publicCampaigns } = await supabase
    .from('campaigns')
    .select('*')
    .eq('is_public', true)
    .order('created_at', { ascending: false })

  // 2. Active tables where user is a participant
  const { data: activeMemberships } = await supabase
    .from('table_members')
    .select('table_id, tables(*, campaigns(title, category))')
    .eq('user_id', user?.id)

  const activeTables = (activeMemberships ?? []).flatMap((membership) => {
    const table = Array.isArray(membership.tables) ? membership.tables[0] : membership.tables
    return table ? [table] : []
  })

  return (
    <div className="min-h-screen bg-zinc-950 text-zinc-100 p-8">
      <div className="max-w-6xl mx-auto space-y-8">
        <div className="flex justify-between items-center border-b border-zinc-800 pb-4">
          <div>
            <h1 className="text-3xl font-bold tracking-tight text-white">Campaign Hub</h1>
            <p className="text-zinc-400 text-sm">Join an existing room, launch a session, or build your worlds.</p>
          </div>
          <div className="flex gap-4 items-center">
            <Link href="/characters" className="text-xs text-zinc-300 hover:text-white bg-zinc-900 border border-zinc-800 px-3 py-1.5 rounded-lg">
              Character Sheets
            </Link>
            <Link href="/campaigns/new" className="text-xs text-white bg-amber-600 hover:bg-amber-500 px-3 py-1.5 rounded-lg font-medium">
              + New Campaign
            </Link>
          </div>
        </div>

        <HubClient publicCampaigns={publicCampaigns || []} activeTables={activeTables} />
      </div>
    </div>
  )
}
